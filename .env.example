# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN used by Python scripts and tests
DATABASE_URL=postgresql://your_db_user:your_secure_password@localhost:5432/your_db_name


# ── Seed configuration ──────────────────────────────────────────────────────
# Changing SEED produces a completely different (but reproducible) dataset
SEED=42

# Set to 100000 / 1000000 for the full production-scale dataset
NUM_CUSTOMERS=10000
NUM_METER_READINGS=100000

# Rows per INSERT batch — increase for faster seeding on high-RAM machines
BATCH_SIZE=5000

# ── pgAdmin (optional – launched with: docker compose --profile admin up) ──
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=8080

