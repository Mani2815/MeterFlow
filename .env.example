# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=meter_to_cash
POSTGRES_USER=meter_user
POSTGRES_PASSWORD=meter_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN used by Python scripts and tests
DATABASE_URL=postgresql://meter_user:meter_pass@localhost:5432/meter_to_cash

# ── Seed configuration ──────────────────────────────────────────────────────
# Changing SEED produces a completely different (but reproducible) dataset
SEED=42

# Set to 100000 / 1000000 for the full production-scale dataset
NUM_CUSTOMERS=10000
NUM_METER_READINGS=100000

# Rows per INSERT batch — increase for faster seeding on high-RAM machines
BATCH_SIZE=5000

# ── pgAdmin (optional – launched with: docker compose --profile admin up) ──
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080
